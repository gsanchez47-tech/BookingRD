# =============================================================================
# BookingRD - Variables de entorno (plantilla)
# Copiar como .env en la raíz del proyecto, o generarlo con: npm run configurar
# El archivo .env no se versiona. Compartirlo solo por un canal privado.
# =============================================================================

# --- Base de datos ------------------------------------------------------------
# Azure SQL Database (base compartida del equipo):
#   DB_SERVER=<servidor>.database.windows.net
#   DB_USER=<usuario administrador del servidor>
#   DB_PASSWORD=<contraseña>
#   DB_TRUST_CERT=false
#
# SQL Server local (valores creados por database/instalacion-completa.sql):
DB_SERVER=localhost
DB_DATABASE=BookingRD
DB_USER=bookingrd_app
DB_PASSWORD=BookingRD#2026!
DB_PORT=1433
# Instancia con nombre (p. ej. SQLEXPRESS): completar y dejar DB_PORT vacío.
DB_INSTANCE=
# true solo para certificados autofirmados (servidor local).
DB_TRUST_CERT=true

# --- Servidor HTTP ------------------------------------------------------------
PORT=3000

# --- Autenticación ------------------------------------------------------------
# Clave de firma de los JWT. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# --- Protección de acceso -------------------------------------------------------
# Intentos de inicio de sesión y registro permitidos por IP cada 10 minutos.
LIMITE_INTENTOS_AUTH=40

# --- Correo electrónico ---------------------------------------------------------
# Bienvenida al registrarse y confirmación de cada reserva (nodemailer).
# Sin SMTP_HOST los correos no se envían: se guardan como HTML en
# correos-enviados/ para revisarlos.
#
# Gmail: activar la verificación en dos pasos y crear una "contraseña de
# aplicación" en https://myaccount.google.com/apppasswords (16 caracteres).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USUARIO=tucuenta@gmail.com
#   SMTP_CLAVE=<contraseña de aplicación>
# Outlook / Hotmail: SMTP_HOST=smtp-mail.outlook.com y SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=BookingRD <no-responder@bookingrd.com>
# Dirección del sitio para los enlaces de los correos.
URL_SITIO=http://localhost:3000
